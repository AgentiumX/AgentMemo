<Window x:Class="DesktopMemo.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopMemo"
        Width="280" Height="320"
        MinWidth="180" MinHeight="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False">

    <Window.Resources>
        <!-- Color dot style -->
        <Style x:Key="ColorDot" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Toolbar button style -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac-style thin scrollbar -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#50000000"
                                CornerRadius="3"
                                Width="6"
                                Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#80000000"/>
                                <Setter TargetName="ThumbBorder" Property="Width" Value="8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource MacScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" CornerRadius="14" Margin="10"
            BorderThickness="0.5">
        <Border.BorderBrush>
            <SolidColorBrush Color="#30000000"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3"
                              Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <Grid x:Name="MainGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>   <!-- Drag handle -->
                <RowDefinition Height="32"/>   <!-- Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- Glass background layer 1: color tint -->
            <Border x:Name="GlassBackground" Grid.RowSpan="6"
                    CornerRadius="14">
                <Border.Background>
                    <SolidColorBrush Color="#C0FFF3B0"/>
                </Border.Background>
            </Border>

            <!-- Glass background layer 2: top highlight (glass reflection) -->
            <Border Grid.RowSpan="6" CornerRadius="14" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="0.3"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                        <GradientStop Color="#08000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Readability overlay: ensures text is legible -->
            <Border x:Name="ReadabilityOverlay" Grid.RowSpan="6"
                    CornerRadius="14" Background="#70FFFFFF" IsHitTestVisible="False"/>

            <!-- Drag Handle -->
            <Border x:Name="DragHandle" Grid.Row="0"
                    Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    MouseEnter="DragHandle_MouseEnter"
                    MouseLeave="DragHandle_MouseLeave">
                <Border x:Name="DragIndicator" Height="3" Width="36"
                        CornerRadius="1.5" Background="#30000000"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="8,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Color dots (visible in edit mode) -->
                <StackPanel x:Name="ColorPanel" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse Style="{StaticResource ColorDot}" Fill="#FFF3B0"
                             Tag="yellow" MouseLeftButtonDown="ColorDot_Click"/>
                    <Ellipse Style="{StaticResource ColorDot}" Fill="#BBDEFB"
                             Tag="blue" MouseLeftButtonDown="ColorDot_Click"/>
                    <Ellipse Style="{StaticResource ColorDot}" Fill="#C8E6C9"
                             Tag="green" MouseLeftButtonDown="ColorDot_Click"/>
                    <Ellipse Style="{StaticResource ColorDot}" Fill="#F8BBD0"
                             Tag="pink" MouseLeftButtonDown="ColorDot_Click"/>
                    <Ellipse Style="{StaticResource ColorDot}" Fill="#CE93D8"
                             Tag="purple" MouseLeftButtonDown="ColorDot_Click"/>
                    <Ellipse Style="{StaticResource ColorDot}" Fill="#CFD8DC"
                             Tag="gray" MouseLeftButtonDown="ColorDot_Click"/>
                </StackPanel>

                <!-- Pin (always on top) button -->
                <Button x:Name="PinButton" Grid.Column="2"
                        Style="{StaticResource ToolButton}"
                        Content="📌" ToolTip="置顶"
                        Click="PinButton_Click" Opacity="0.5"/>

                <!-- Close button (hides note, does not delete) -->
                <Button x:Name="CloseButton" Grid.Column="3"
                        Style="{StaticResource ToolButton}"
                        Content="✕" ToolTip="隐藏便笺" FontSize="12"
                        Click="CloseButton_Click" Opacity="0.5"/>
            </Grid>

            <!-- Separator line -->
            <Border Grid.Row="2" Height="1" Margin="12,0" Opacity="0.15"
                    Background="#000000"/>

            <!-- Title -->
            <Border Grid.Row="3" Margin="14,8,14,0">
                <Grid>
                    <!-- Display mode title -->
                    <TextBlock x:Name="TitleDisplay"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#222222"
                               TextWrapping="Wrap"
                               MouseLeftButtonUp="ContentArea_MouseLeftButtonUp"
                               Text="新便笺"/>

                    <!-- Edit mode title -->
                    <TextBox x:Name="TitleEdit"
                             FontSize="16" FontWeight="SemiBold"
                             Foreground="#222222"
                             Background="Transparent"
                             BorderBrush="#30000000"
                             BorderThickness="0,0,0,1"
                             Padding="0,0,0,2"
                             TextWrapping="Wrap"
                             Visibility="Collapsed"
                             Text="新便笺"
                             CaretBrush="#333333"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Border Grid.Row="4" Margin="14,8,14,4">
                <Grid>
                    <!-- Display mode: TextBlock-based viewer -->
                    <ScrollViewer x:Name="ContentDisplay"
                                  Style="{StaticResource MacScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  MouseLeftButtonUp="ContentArea_MouseLeftButtonUp"
                                  Padding="0">
                        <StackPanel x:Name="ContentPanel"/>
                    </ScrollViewer>

                    <!-- Edit mode: TextBox -->
                    <TextBox x:Name="ContentEdit"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#333333"
                             FontSize="14"
                             FontFamily="Segoe UI, Microsoft YaHei"
                             Padding="0"
                             Visibility="Collapsed"
                             TextChanged="ContentEdit_TextChanged"
                             CaretBrush="#333333"/>
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Grid Grid.Row="5" Margin="10,0,10,6" Height="20">
                <!-- Edit mode indicator -->
                <TextBlock x:Name="EditIndicator"
                           Text="✏ 编辑中 · ESC 或点击外部退出"
                           FontSize="10"
                           Foreground="#50000000"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Visibility="Collapsed"/>

                <!-- Resize handle -->
                <Border x:Name="ResizeHandle"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="16" Height="16"
                        Cursor="SizeNWSE"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        Visibility="Collapsed">
                    <Path Data="M 14,4 L 4,14 M 14,8 L 8,14 M 14,12 L 12,14"
                          Stroke="#35000000" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
